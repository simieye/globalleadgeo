#!/bin/zsh
# 全球鹰 GEO 全球AI推荐系统 - macOS 应用启动器
# 首次运行会在 ~/Library/Application Support/GlobalEagleGEO 创建独立虚拟环境并离线安装依赖，
# 随后后台启动本地服务（127.0.0.1:8787）并自动打开浏览器。
set -u

HERE=${0:A:h}
RES="$HERE/../Resources"
APP_DIR="$RES/app"
WHEELS="$RES/wheels"
SUP="$HOME/Library/Application Support/GlobalEagleGEO"
VENV="$SUP/venv"
DATA="$SUP/data"
LOG="$SUP/server.log"
PORT="${GEO_PORT:-8787}"

alert() {
  osascript -e "display alert \"$1\" message \"$2\" buttons {\"好\"} default button 1" >/dev/null 2>&1 || true
}

PY=""
for c in python3.14 python3.13 python3.12 python3.11 python3.10 python3; do
  if command -v "$c" >/dev/null 2>&1; then PY="$c"; break; fi
done
if [ -z "$PY" ]; then
  alert "缺少 Python 运行环境" "请先安装 Python 3.10 或更高版本：https://www.python.org/downloads/"
  exit 1
fi

mkdir -p "$SUP" "$DATA"

install_deps() {
  if [ -d "$WHEELS" ] && [ -n "$(ls -A "$WHEELS" 2>/dev/null)" ]; then
    "$VENV/bin/python" -m pip install --no-index --find-links "$WHEELS" \
      -r "$APP_DIR/requirements.txt" >>"$LOG" 2>&1
    if "$VENV/bin/python" -c "import fastapi, uvicorn, pydantic" >/dev/null 2>&1; then
      return 0
    fi
  fi
  # 离线 wheel 与本机型/Python 版本不匹配时，退化为联网安装
  "$VENV/bin/python" -m pip install -r "$APP_DIR/requirements.txt" >>"$LOG" 2>&1
}

if [ ! -x "$VENV/bin/python" ]; then
  "$PY" -m venv "$VENV" >>"$LOG" 2>&1
  install_deps
fi

if ! [ -x "$VENV/bin/python" ]; then
  alert "依赖安装失败" "请查看日志：$LOG"
  open "$LOG"
  exit 1
fi

if curl -s -m 2 "http://127.0.0.1:$PORT/api/health" >/dev/null 2>&1; then
  open "http://127.0.0.1:$PORT"
  exit 0
fi

export GEO_DATA_DIR="$DATA"
export PYTHONPATH="$APP_DIR"
cd "$APP_DIR" || exit 1
nohup "$VENV/bin/python" -m uvicorn backend.main:app --host 127.0.0.1 --port "$PORT" >>"$LOG" 2>&1 &

for _i in {1..60}; do
  sleep 0.5
  if curl -s -m 2 "http://127.0.0.1:$PORT/api/health" >/dev/null 2>&1; then
    open "http://127.0.0.1:$PORT"
    exit 0
  fi
done

alert "服务启动超时" "请查看日志：$LOG"
open "$LOG"
exit 1
