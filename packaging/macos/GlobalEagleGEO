#!/bin/zsh
# 回退启动器：当打包机无法编译 Swift 原生窗口壳时使用（改为打开默认浏览器）
set -u

HERE=${0:A:h}
RES="$HERE/../Resources"
LOG="$HOME/Library/Application Support/GlobalEagleGEO/server.log"
PORT="${GEO_PORT:-8787}"

if curl -s -m 2 "http://127.0.0.1:$PORT/api/health" >/dev/null 2>&1; then
  open "http://127.0.0.1:$PORT"
  exit 0
fi

chmod 755 "$RES/server.sh" 2>/dev/null || true
nohup /bin/zsh "$RES/server.sh" >>"$LOG" 2>&1 &

for _i in {1..240}; do
  sleep 0.5
  if curl -s -m 2 "http://127.0.0.1:$PORT/api/health" >/dev/null 2>&1; then
    open "http://127.0.0.1:$PORT"
    exit 0
  fi
done

osascript -e "display alert \"服务启动超时\" message \"请查看日志：$LOG\" buttons {\"好\"} default button 1" >/dev/null 2>&1 || true
open "$LOG"
exit 1
